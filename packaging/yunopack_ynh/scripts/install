#!/bin/bash
# Genere par yunopack.

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# DEPLOIEMENT DES SOURCES
#=================================================
ynh_script_progression "Mise en place des fichiers de $app..."

ynh_setup_source --dest_dir="$install_dir"

chown -R "$app:www-data" "$install_dir"

#=================================================
# CONFIGURATIONS SYSTEME
#=================================================
ynh_script_progression "Ajout des configurations systeme liees a $app..."

ynh_config_add_nginx

ynh_config_add_systemd

mkdir -p "/var/log/$app"
chown -R "$app:www-data" "/var/log/$app"
ynh_config_add_logrotate

yunohost service add "$app" --description="Yunopack" --log="/var/log/$app/$app.log"

#=================================================
# LOGO DU PORTAIL
#=================================================

# Le portail affiche le logo enregistre sur la permission ; sans lui,
# l'application apparait avec l'icone generique. Le catalogue officiel le
# fournirait, mais pas pour un paquet installe depuis une URL.
yunohost user permission update "$app.main" --logo "$YNH_APP_BASEDIR/conf/logo.png" 2>/dev/null || true

#=================================================
# DEMARRAGE DU SERVICE
#=================================================
ynh_script_progression "Demarrage du service de $app..."

ynh_systemctl --service="$app" --action="start"

#=================================================
# FIN DU SCRIPT
#=================================================

ynh_script_progression "Installation de $app terminee"
